{
  "name": "job-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:apis": "tsx --env-file-if-exists=.env.local scripts/verify-apis.ts",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "reclassify": "tsx --env-file-if-exists=.env.local scripts/reclassify.ts",
    "verify:local": "tsx --env-file-if-exists=.env.local scripts/verify-local.ts"
  },
  "dependencies": {
    "he": "^1.2.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.5",
    "postgres": "^4.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/he": "^1.2.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  }
}
